{
  "name": "opus-promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "Vídeos verticais (9:16) da Opus SoftWorks feitos com Remotion: lançamento (30s/30fps) e promo institucional (30s/60fps)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render OpusLaunch out/opus-launch.mp4",
    "render:promo": "remotion render OpusPromo out/opus-promo.mp4",
    "capture": "node scripts/capture-site.mjs",
    "qa": "node scripts/qa-stills.mjs && python3 scripts/qa.py"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "playwright-core": "1.56.1",
    "typescript": "7.0.2"
  }
}
